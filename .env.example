# Copy to .env and replace every value marked CHANGE_ME before running.
# Generate strong secrets with: python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Application -------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- PostgreSQL --------------------------------------------------------------
POSTGRES_DB=aegis
POSTGRES_USER=aegis
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
# Inside docker compose the host is "postgres"; for local dev use "localhost".
# Schema-owner URL: used ONLY by Alembic (the compose `migrate` service), never by the API.
DATABASE_URL=postgresql+psycopg://aegis:CHANGE_ME_postgres_password@postgres:5432/aegis
# Password for the restricted aegis_app role, which migrations create (min 32 printable
# ASCII chars). It must match the password in APP_DATABASE_URL, so keep it URL-safe
# (the token_urlsafe command above is).
APP_DB_PASSWORD=CHANGE_ME_app_db_password
# Restricted URL the API connects with: DML only, SELECT/INSERT only on audit_logs.
APP_DATABASE_URL=postgresql+psycopg://aegis_app:CHANGE_ME_app_db_password@postgres:5432/aegis

# --- Redis -------------------------------------------------------------------
REDIS_PASSWORD=CHANGE_ME_redis_password
REDIS_URL=redis://:CHANGE_ME_redis_password@redis:6379/0

# --- Auth / JWT (min 32 chars) -----------------------------------------------
JWT_SECRET=CHANGE_ME_at_least_32_characters_long_random_value
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=10
REFRESH_TOKEN_DAYS=7
# Keep true outside local HTTP development; the app refuses COOKIE_SECURE=false in production.
COOKIE_SECURE=true

# --- MFA (Fernet key, encrypts TOTP secrets at rest) -------------------------
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MFA_ENCRYPTION_KEY=CHANGE_ME_generate_a_fernet_key_with_the_command_above

# --- Visitor badges (min 32 chars) -------------------------------------------
BADGE_HMAC_SECRET=CHANGE_ME_at_least_32_characters_long_random_value
BADGE_TTL_MINUTES=480

# --- Rate limiting (fixed window, Redis-backed) ------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT_REQUESTS=100
RATE_LIMIT_DEFAULT_WINDOW_SECONDS=60
RATE_LIMIT_LOGIN_REQUESTS=5
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60

# --- Edge --------------------------------------------------------------------
NGINX_HTTP_PORT=8080
